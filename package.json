{
  "name": "ledger-next",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @ledger/web dev",
    "build": "pnpm --filter @ledger/web build",
    "lint": "eslint apps packages tests",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node scripts/docker-test.mjs",
    "test:e2e:runner": "playwright test",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "progress": "node scripts/progress.mjs status",
    "contract:generate": "tsx packages/contracts/src/cli.ts generate",
    "contract:check": "tsx packages/contracts/src/cli.ts check",
    "test:contract": "tsx packages/contracts/src/cli.ts check",
    "db:rollback": "tsx packages/db/src/rollback.ts",
    "test:api": "playwright test --project=api",
    "channels:rewrap": "tsx scripts/rewrap-channel-keys.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "better-auth": "1.7.7",
    "bullmq": "6.3.11",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.3",
    "ioredis": "5.8.2",
    "mysql2": "3.24.5",
    "nodemailer": "8.0.11",
    "openapi-fetch": "0.17.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
