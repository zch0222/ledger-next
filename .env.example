# Ledger Next configuration template; every variable is described in README.md ("环境变量").
# Do not copy it by hand: generate .env with fresh random secrets (never overwrites an existing .env):
#   sh scripts/setup-env.sh [--app-url https://ledger.example]
#   docker compose -f compose.tools.yaml run --rm setup-env [--app-url https://ledger.example]
# Values marked <generated> are replaced with random values. Commented "# KEY=default" lines are optional:
# uncomment to override the built-in default, and delete the line again rather than leaving "KEY=" empty.

# --- Database (MySQL container; credentials are fixed when the data volume is first initialised) ---
MYSQL_DATABASE=ledger
MYSQL_USER=ledger
MYSQL_PASSWORD=<generated>
MYSQL_ROOT_PASSWORD=<generated>

# --- Web ---
# Public origin users open; production must be https://. Cookies, CSRF origin checks and MCP Host checks use it.
APP_URL=http://localhost:3000
# Host port bound on 127.0.0.1 only; put a reverse proxy in front of it.
WEB_PORT=3000
# WEB_CONCURRENCY=4

# --- Secrets (back up separately from database backups) ---
# Session signing key; changing it signs every user out.
BETTER_AUTH_SECRET=<generated>
# Master keys for channel credentials: "id:base64(32 random bytes)", comma-separated, the first one encrypts.
# Rotate by prepending a new key and running the re-wrap; never remove a key that is still in use.
LEDGER_ENCRYPTION_KEYS=k1:<generated>

# --- Exchange rates (Fixer-compatible provider; empty URL disables fetching) ---
FX_PROVIDER_URL=
FX_PROVIDER_KEY=
# FX_PROVIDER=fixer
# FX_POLL_SECONDS=60
# Comma-separated e-mails allowed to trigger FX refresh jobs.
LEDGER_ADMIN_EMAILS=

# --- Notifications ---
# Outgoing mail for the e-mail channel, e.g. smtps://user:password@smtp.example.com:465 (empty disables e-mail).
SMTP_URL=
SMTP_FROM=Ledger Next <no-reply@example.com>
# Self-hosted webhook receivers on a private network (host or host:port, comma-separated); empty = public HTTPS only.
WEBHOOK_ALLOWLIST=
# NOTIFY_TICK_SECONDS=10
# SUBSCRIPTION_TICK_SECONDS=600
# CHANNEL_TIMEOUT_MS=10000

# --- Agents and MCP ---
# AGENT_APPROVAL_AMOUNT=10000
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=

# --- Rate limits (requests per minute) ---
# API_RATE_LIMIT=600
# API_WRITE_RATE_LIMIT=120
# AGENT_WRITE_RATE_LIMIT=30
# API_AUTH_FAILURE_LIMIT=30

# --- Host-side development only (pnpm dev / test:integration on the host); Compose uses its own internal addresses ---
DATABASE_URL=mysql://ledger:<generated>@localhost:3306/ledger
REDIS_URL=redis://localhost:6379
