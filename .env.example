# Copy to .env; use independent random values before starting Compose.
MYSQL_DATABASE=ledger
MYSQL_USER=ledger
MYSQL_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
WEB_PORT=3000
# For host-based development; Compose supplies its own internal addresses.
DATABASE_URL=mysql://ledger:replace-with-random-password@localhost:3306/ledger
REDIS_URL=redis://localhost:6379
# FX provider (Fixer-compatible). Leave empty to disable fetching; the local mock is wired by compose.mock.yaml.
FX_PROVIDER_URL=
FX_PROVIDER_KEY=
# Comma-separated e-mails allowed to trigger FX refresh jobs.
LEDGER_ADMIN_EMAILS=
# Master keys for channel credentials: "id:base64(32 random bytes)", comma-separated, first one encrypts.
# Rotate by prepending a new key and running the re-wrap script; never remove a key still in use.
LEDGER_ENCRYPTION_KEYS=k1:replace-with-base64-of-32-random-bytes
# Outgoing mail for the e-mail channel, e.g. smtps://user:password@smtp.example.com:465 (empty disables e-mail).
SMTP_URL=
SMTP_FROM=Ledger Next <no-reply@example.com>
# Allowlist for self-hosted webhook receivers on a private network (host or host:port, comma-separated).
WEBHOOK_ALLOWLIST=
